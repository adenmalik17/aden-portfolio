{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start portfolio server",
      "type": "shell",
      "command": "node server.js",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "Portfolio running at"
        }
      },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
